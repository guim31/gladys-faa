            "de": "Ursache",
            "es": "Causa"
          }
        },
        {
          "key": "departure_delay",
          "type": "number",
          "label": {
            "en": "Departure delay (min)",
            "fr": "Retard au départ (min)",
            "de": "Abflugverspätung (Min.)",
            "es": "Retraso de salidas (min)"
          }
        },
        {
          "key": "arrival_delay",
          "type": "number",
          "label": {
            "en": "Arrival delay (min)",
            "fr": "Retard à l'arrivée (min)",
            "de": "Ankunftsverspätung (Min.)",
            "es": "Retraso de llegadas (min)"
          }
        },
        {
          "key": "until",
          "type": "string",
          "label": {
            "en": "Expected end",
            "fr": "Fin prévue",
            "de": "Voraussichtliches Ende",
            "es": "Fin prevista"
          }
        }
      ]
    }
