      "key": "get_airport_status",
      "label": {
        "en": "Get an airport status",
        "fr": "Lire l'état d'un aéroport",
        "de": "Flughafenstatus abrufen",
        "es": "Obtener el estado de un aeropuerto"
      },
      "description": {
        "en": "The status of a followed airport, as numbers and as a sentence for a message or a speaker.",
        "fr": "L'état d'un aéroport suivi, en nombres et en phrase pour un message ou une enceinte.",
        "de": "Der Status eines verfolgten Flughafens, als Zahlen und als Satz für eine Nachricht oder einen Lautsprecher.",
